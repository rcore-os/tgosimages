diff --git a/components/libc/compilers/common/include/musl_compat.h b/components/libc/compilers/common/include/musl_compat.h
new file mode 100644
index 0000000000..02189306ff
--- /dev/null
+++ b/components/libc/compilers/common/include/musl_compat.h
@@ -0,0 +1,160 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Compatibility header providing musl-libc/Linux definitions needed by
+ * RT-Thread LWP when building with bare-metal newlib toolchain.
+ */
+
+#ifndef __MUSL_COMPAT_H__
+#define __MUSL_COMPAT_H__
+
+/* ── POSIX / Linux errno ─────────────────────────────────────────────── */
+
+#ifndef ERESTART
+#define ERESTART        85
+#endif
+
+/* ── Missing types ───────────────────────────────────────────────────── */
+
+#ifndef __clockid_t_defined
+typedef int clockid_t;
+#define __clockid_t_defined
+#endif
+
+#ifndef __timer_t_defined
+typedef void *timer_t;
+#define __timer_t_defined
+#endif
+
+#ifndef __suseconds_t_defined
+typedef long suseconds_t;
+#define __suseconds_t_defined
+#endif
+
+#ifndef __clock_t_defined
+typedef long clock_t;
+#define __clock_t_defined
+#endif
+
+#ifndef _PID_T_DECLARED
+typedef int pid_t;
+#define _PID_T_DECLARED
+#endif
+
+/* ── Signal flags (SA_*) ─────────────────────────────────────────────── */
+
+#ifndef SA_NOCLDSTOP
+#define SA_NOCLDSTOP    0x00000001
+#endif
+#ifndef SA_NOCLDWAIT
+#define SA_NOCLDWAIT    0x00000002
+#endif
+#ifndef SA_SIGINFO
+#define SA_SIGINFO      0x00000004
+#endif
+#ifndef SA_RESTORER
+#define SA_RESTORER     0x04000000
+#endif
+#ifndef SA_ONSTACK
+#define SA_ONSTACK      0x08000000
+#endif
+#ifndef SA_RESTART
+#define SA_RESTART      0x10000000
+#endif
+#ifndef SA_NODEFER
+#define SA_NODEFER      0x40000000
+#endif
+
+/* ── SI_* codes ──────────────────────────────────────────────────────── */
+
+#ifndef SI_KERNEL
+#define SI_KERNEL       0x80
+#endif
+
+/* ── CLD_* codes (for SIGCHLD si_code) ───────────────────────────────── */
+
+#ifndef CLD_EXITED
+#define CLD_EXITED      1
+#endif
+#ifndef CLD_KILLED
+#define CLD_KILLED      2
+#endif
+#ifndef CLD_DUMPED
+#define CLD_DUMPED      3
+#endif
+#ifndef CLD_TRAPPED
+#define CLD_TRAPPED     4
+#endif
+#ifndef CLD_STOPPED
+#define CLD_STOPPED     5
+#endif
+#ifndef CLD_CONTINUED
+#define CLD_CONTINUED   6
+#endif
+
+/* ── Wait / status macros ────────────────────────────────────────────── */
+
+#ifndef WEXITSTATUS
+#define WEXITSTATUS(s)  (((s) >> 8) & 0xff)
+#endif
+#ifndef WTERMSIG
+#define WTERMSIG(s)     ((s) & 0x7f)
+#endif
+#ifndef WIFSTOPPED
+#define WIFSTOPPED(s)   (WTERMSIG(s) == 0x7f)
+#endif
+#ifndef WIFSIGNALED
+#define WIFSIGNALED(s)  (((signed char)(((s) & 0x7f) + 1) >> 1) > 0)
+#endif
+#ifndef WIFCONTINUED
+#define WIFCONTINUED(s) ((s) == 0xffff)
+#endif
+
+/* ── File flags ──────────────────────────────────────────────────────── */
+
+#ifndef O_CLOEXEC
+#define O_CLOEXEC       02000000
+#endif
+#ifndef O_DIRECT
+#define O_DIRECT        040000
+#endif
+#ifndef F_DUPFD_CLOEXEC
+#define F_DUPFD_CLOEXEC 1030
+#endif
+#ifndef O_LARGEFILE
+#define O_LARGEFILE     0400000
+#endif
+
+/* ── CPU set ──────────────────────────────────────────────────────────── */
+
+#ifndef _CPU_SET_T_defined
+#define _CPU_SET_T_defined
+typedef struct { unsigned long __bits[128 / sizeof(long)]; } cpu_set_t;
+#endif
+
+#ifndef CPU_SET_SIZE
+#define CPU_SET_SIZE (sizeof(cpu_set_t))
+#endif
+
+#ifndef CPU_ZERO_S
+#define CPU_ZERO_S(size, set)   do { size_t _i; for (_i = 0; _i < (size)/sizeof(long); _i++) ((long*)(set))[_i] = 0; } while(0)
+#endif
+
+#ifndef CPU_SET_S
+#define CPU_SET_S(cpu, size, set) do { if ((size_t)(cpu) < 8*(size)) ((long*)(set))[(cpu)/(8*sizeof(long))] |= (1UL << ((cpu) % (8*sizeof(long)))); } while(0)
+#endif
+
+#ifndef CPU_ISSET_S
+#define CPU_ISSET_S(cpu, size, set) (((size_t)(cpu) < 8*(size)) ? (((long*)(set))[(cpu)/(8*sizeof(long))] & (1UL << ((cpu) % (8*sizeof(long))))) != 0 : 0)
+#endif
+
+/* ── siginfo_t extensions ────────────────────────────────────────────── */
+/*
+ * The minimal newlib/RT-Thread siginfo_t only has si_signo, si_code, si_value.
+ * LWP code expects additional members. We cannot modify the struct in-place,
+ * so code using these members must be adapted; this header only ensures the
+ * *types and constants* are available. The siginfo_t members like si_pid,
+ * si_status etc. need to be handled at the source level.
+ */
+
+#endif /* __MUSL_COMPAT_H__ */
diff --git a/components/libc/compilers/common/include/sys/epoll.h b/components/libc/compilers/common/include/sys/epoll.h
new file mode 100644
index 0000000000..8d17cf0240
--- /dev/null
+++ b/components/libc/compilers/common/include/sys/epoll.h
@@ -0,0 +1,49 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Stub sys/epoll.h for builds without musl libc.
+ */
+#ifndef _SYS_EPOLL_H
+#define _SYS_EPOLL_H
+
+#include <sys/types.h>
+
+#define EPOLLIN          0x001
+#define EPOLLPRI         0x002
+#define EPOLLOUT         0x004
+#define EPOLLERR         0x008
+#define EPOLLHUP         0x010
+#define EPOLLRDNORM      0x040
+#define EPOLLRDBAND      0x080
+#define EPOLLWRNORM      0x100
+#define EPOLLWRBAND      0x200
+#define EPOLLMSG         0x400
+#define EPOLLRDHUP       0x2000
+#define EPOLLEXCLUSIVE   (1U << 28)
+#define EPOLLWAKEUP      (1U << 29)
+#define EPOLLONESHOT     (1U << 30)
+#define EPOLLET          (1U << 31)
+
+#define EPOLL_CTL_ADD    1
+#define EPOLL_CTL_DEL    2
+#define EPOLL_CTL_MOD    3
+
+typedef union epoll_data {
+    void    *ptr;
+    int      fd;
+    uint32_t u32;
+    uint64_t u64;
+} epoll_data_t;
+
+struct epoll_event {
+    uint32_t     events;
+    epoll_data_t data;
+};
+
+int epoll_create(int size);
+int epoll_create1(int flags);
+int epoll_ctl(int epfd, int op, int fd, struct epoll_event *event);
+int epoll_wait(int epfd, struct epoll_event *events, int maxevents, int timeout);
+int epoll_pwait(int epfd, struct epoll_event *events, int maxevents, int timeout, const sigset_t *sigmask);
+
+#endif /* _SYS_EPOLL_H */
