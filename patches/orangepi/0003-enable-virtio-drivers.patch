From: TGOSKits contributors
Subject: [PATCH] kernel: enable virtio block, MMIO, PCI and network drivers

Build the Orange Pi guest kernel with built-in VirtIO transports and device
drivers so disks can be used during boot and network devices are available.

--- a/external/config/kernel/linux-rockchip-rk3588-current.config
+++ b/external/config/kernel/linux-rockchip-rk3588-current.config
@@ -2137,6 +2137,6 @@
 CONFIG_BLK_DEV_RAM_SIZE=4096
 # CONFIG_CDROM_PKTCDVD is not set
 # CONFIG_ATA_OVER_ETH is not set
-# CONFIG_VIRTIO_BLK is not set
+CONFIG_VIRTIO_BLK=y
 # CONFIG_BLK_DEV_RBD is not set
 # CONFIG_BLK_DEV_UBLK is not set
@@ -2413,6 +2413,6 @@
 CONFIG_TUN_VNET_CROSS_LE=y
 CONFIG_VETH=m
-# CONFIG_VIRTIO_NET is not set
+CONFIG_VIRTIO_NET=y
 CONFIG_NLMON=m
 # CONFIG_MHI_NET is not set
 CONFIG_ARCNET=m
@@ -6574,10 +6574,10 @@
 CONFIG_VIRTIO_ANCHOR=y
 CONFIG_VIRTIO=y
 CONFIG_VIRTIO_MENU=y
-# CONFIG_VIRTIO_PCI is not set
+CONFIG_VIRTIO_PCI=y
 # CONFIG_VIRTIO_BALLOON is not set
 # CONFIG_VIRTIO_INPUT is not set
-# CONFIG_VIRTIO_MMIO is not set
+CONFIG_VIRTIO_MMIO=y
 # CONFIG_VDPA is not set
 CONFIG_VHOST_MENU=y
 # CONFIG_VHOST_NET is not set
