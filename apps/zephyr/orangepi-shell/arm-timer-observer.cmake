# Build an observed copy for this application; keep the Zephyr checkout intact.
if(NOT CONFIG_ARM_ARCH_TIMER)
  message(FATAL_ERROR "Orange Pi IRQ measurements require the ARM architectural timer")
endif()
set(timer_input "${ZEPHYR_BASE}/drivers/timer/arm_arch_timer.c")
set(timer_output "${CMAKE_CURRENT_BINARY_DIR}/orangepi-arm-arch-timer.c")
set(observer_script "${CMAKE_CURRENT_SOURCE_DIR}/scripts/instrument-arm-timer.py")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${timer_input}" "${observer_script}")
execute_process(COMMAND python3 "${observer_script}" "${timer_input}" "${timer_output}"
  RESULT_VARIABLE observer_result)
if(NOT observer_result EQUAL 0)
  message(FATAL_ERROR "Cannot instrument the ARM timer driver for this app")
endif()
get_target_property(timer_sources drivers__timer SOURCES)
set(observed_sources "")
set(replaced_timer FALSE)
foreach(timer_source IN LISTS timer_sources)
  if(timer_source MATCHES "(^|/)arm_arch_timer\\.c$")
    list(APPEND observed_sources "${timer_output}")
    set(replaced_timer TRUE)
  else()
    list(APPEND observed_sources "${timer_source}")
  endif()
endforeach()
if(NOT replaced_timer)
  message(FATAL_ERROR "ARM timer source was not selected; review Zephyr integration")
endif()
set_property(TARGET drivers__timer PROPERTY SOURCES ${observed_sources})
